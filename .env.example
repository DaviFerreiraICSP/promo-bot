# Ambiente (development | production | test)
NODE_ENV=production

# Porta do servidor HTTP (O Railway preenche isso automaticamente)
PORT=3000
HOST=0.0.0.0

# Conexão com o Banco de Dados PostgreSQL (No Railway: adicione o plugin PostgreSQL e use a variável DATABASE_URL fornecida)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/promobot?schema=public"

# Token do Bot Telegram gerado pelo @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCDefghIJKLmnOPqrstUVwxyz"

# URL pública da sua aplicação no Railway (opcional, para modo Webhook. Se omitido, usa Long Polling)
# Exemplo: https://promo-bot-production.up.railway.app
TELEGRAM_WEBHOOK_URL=""

# ID do Telegram do Administrador Geral / Dono do Bot (opcional)
ADMIN_TELEGRAM_ID=""

# Intervalo em minutos para verificação automática de novas ofertas
SCRAPER_INTERVAL_MINUTES=10

# Ativar busca automática de promoções 24/7 (true ou false)
ENABLE_AUTO_SCRAPER=true

# --- Autenticação do Dashboard Web ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
JWT_SECRET="promobot_secret_session_key_2026"

# --- Integração Opcional com WhatsApp ---
# Exemplo: Evolution API, Z-API ou gateway HTTP compatível
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""
